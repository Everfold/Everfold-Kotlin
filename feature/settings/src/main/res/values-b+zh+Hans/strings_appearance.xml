    <string name="appearance_palette_style_label">调色风格</string>
    <string name="palette_style_tonal_spot">标准色调 (Tonal Spot)</string>
    <string name="palette_style_tonal_spot_desc">Material You 默认均衡色调，柔和克制、耐看百搭。</string>
    <string name="palette_style_neutral">中性柔和 (Neutral)</string>
    <string name="palette_style_neutral_desc">大幅降低饱和度，界面趋近中性灰度。</string>
    <string name="palette_style_vibrant">鲜明活力 (Vibrant)</string>
    <string name="palette_style_vibrant_desc">提升主色与辅色彩度，视觉表现更鲜亮。</string>
    <string name="palette_style_expressive">表现力 (Expressive)</string>
    <string name="palette_style_expressive_desc">引入与种子色相跳跃搭配的辅色与点缀色，更有活力。</string>
    <string name="palette_style_rainbow">彩虹 (Rainbow)</string>
    <string name="palette_style_rainbow_desc">保留彩色强调色，同时背景表面采用纯中性灰度。</string>
    <string name="palette_style_fruit_salad">水果拼盘 (Fruit Salad)</string>
    <string name="palette_style_fruit_salad_desc">通过旋转色相生成明快跳脱的多彩组合。</string>
    <string name="palette_style_monochrome">单色极简 (Monochrome)</string>
    <string name="palette_style_monochrome_desc">完全去除色彩倾向的纯粹黑白灰单色阶。</string>
    <string name="palette_style_fidelity">高保真 (Fidelity)</string>
    <string name="palette_style_fidelity_desc">尽可能保留所选种子色的原始观感并配互补点缀。</string>
    <string name="palette_style_content">内容匹配 (Content)</string>
    <string name="palette_style_content_desc">忠实还原种子色，并搭配邻近色系保持视觉统一。</string>

