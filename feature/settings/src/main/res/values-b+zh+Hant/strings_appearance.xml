    <string name="appearance_palette_style_label">調色風格</string>
    <string name="palette_style_tonal_spot">標準色調 (Tonal Spot)</string>
    <string name="palette_style_tonal_spot_desc">Material You 預設均衡色調，柔和克制、耐看百搭。</string>
    <string name="palette_style_neutral">中性柔和 (Neutral)</string>
    <string name="palette_style_neutral_desc">大幅降低飽和度，介面趨近中性灰度。</string>
    <string name="palette_style_vibrant">鮮明活力 (Vibrant)</string>
    <string name="palette_style_vibrant_desc">提升主色與輔色彩度，視覺表現更鮮亮。</string>
    <string name="palette_style_expressive">表現力 (Expressive)</string>
    <string name="palette_style_expressive_desc">引入與種子色相跳躍搭配的輔色與點綴色，更有活力。</string>
    <string name="palette_style_rainbow">彩虹 (Rainbow)</string>
    <string name="palette_style_rainbow_desc">保留彩色強調色，同時背景表面採用純中性灰度。</string>
    <string name="palette_style_fruit_salad">水果拼盤 (Fruit Salad)</string>
    <string name="palette_style_fruit_salad_desc">透過旋轉色相產生明快跳脫的多彩組合。</string>
    <string name="palette_style_monochrome">單色極簡 (Monochrome)</string>
    <string name="palette_style_monochrome_desc">完全去除色彩傾向的純粹黑白灰單色階。</string>
    <string name="palette_style_fidelity">高保真 (Fidelity)</string>
    <string name="palette_style_fidelity_desc">盡可能保留所選種子色的原始觀感並配互補點綴。</string>
    <string name="palette_style_content">內容匹配 (Content)</string>
    <string name="palette_style_content_desc">忠實還原種子色，並搭配鄰近色系保持視覺統一。</string>

